# Copy to `.env` for local development. `.env` is gitignored; this file is not,
# so it must never hold a real value.

# Leave OPENAI_API_KEY unset to run in deterministic STUB mode (no network, no cost).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# The app runs live whenever OPENAI_API_KEY is set. C360_LLM_MODE=stub forces the
# deterministic client (the test suite uses it); leave it unset otherwise.
# C360_LLM_MODE=

# The two app accounts. Without them nobody can sign in, locally included.
C360_RATER_USER=
C360_RATER_PASSWORD=
C360_HR_USER=
C360_HR_PASSWORD=

# --- demo deployment only ---------------------------------------------------
# Set these on Render, not locally. See DEPLOY.md.
# C360_SEED_ON_BOOT=1
# C360_DEMO_BANNER=1
