# --- secrets ----------------------------------------------------------------
# Holds a live OpenAI key locally. Never commit it; Render takes the key as a
# dashboard secret instead.
.env

# --- local environment ------------------------------------------------------
.venv360/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# --- generated at runtime ---------------------------------------------------
# Everything under data/ is rebuilt: `config.py` creates the directory, and the
# demo seeds the round on boot. invites.json in particular carries assigned
# email addresses and must not be published.
data/*.db
# SQLite's working files beside an open database. `data/*.db` does not match
# them, and a stray copy committed next to a live database is a corruption risk.
data/*.db-shm
data/*.db-wal
data/*.db-journal
data/*.sqlite
data/invites.json
data/web-settings.json
data/probe_policy.json
data/reports/

# Test-coverage output. Nothing in this project writes it; an empty copy came
# across from the client repository's root and is ignored rather than kept.
coverage/
